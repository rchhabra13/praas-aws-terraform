# Copy this file to .env and fill in real values yourself (never in chat).
# .env is already gitignored — do not remove that entry.

# GitHub PAT (repo scope) — used by the `integrations/github` Terraform provider.
GITHUB_TOKEN=

# AWS IAM user credentials — used by the `hashicorp/aws` Terraform provider,
# and by the deployer-iam-policy.json principal to run `terraform apply`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional overrides matching infra/variables.tf defaults.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
